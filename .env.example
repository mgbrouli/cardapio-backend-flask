# ===========================
# ASAAS - Integração de Pagamentos
# ===========================
# Chave de API do Asaas para Sandbox (testes)
# Obtenha em: https://sandbox.asaas.com/
ASAAS_API_KEY=
ASAAS_SANDBOX=True

# ===========================
# FastAPI Configuration
# ===========================
APP_ENV=development
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# ===========================
# Database
# ===========================
# Deixe em branco para usar o padrão (banco.db na raiz do projeto)
# DATABASE_URL=

# ===========================
# Webhook Asaas (após deploy)
# ===========================
WEBHOOK_SECRET=

# Stripe (opcional; configurar os dois segredos para habilitar o provedor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública HTTPS da aplicação em produção
PUBLIC_BASE_URL=

# E-mails de contas existentes autorizadas ao painel administrador
ADMIN_EMAILS=

# SMTP para confirmação de conta e recuperação de senha
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_SSL=False

# Em production a confirmação é obrigatória por padrão.
# Em desenvolvimento local fica desativada; defina True para testar o fluxo.
# REQUIRE_EMAIL_VERIFICATION=
