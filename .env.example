# ===========================
# ASAAS - Integração de Pagamentos
# ===========================
# Chave de API do Asaas para Sandbox (testes)
# Obtenha em: https://sandbox.asaas.com/
ASAAS_API_KEY=seu-asaas-api-key-aqui
ASAAS_SANDBOX=True

# ===========================
# Flask Configuration
# ===========================
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# ===========================
# Database
# ===========================
# Deixe em branco para usar o padrão (banco.db na raiz do projeto)
# DATABASE_URL=

# ===========================
# Email (opcional)
# ===========================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicacao

# ===========================
# Webhook Asaas (após deploy)
# ===========================
WEBHOOK_SECRET=sua-senha-webhook-asaas
